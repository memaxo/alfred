{
  "extends": [
    "./node_modules/ultracite/config/oxlint/core/.oxlintrc.json",
    "./node_modules/ultracite/config/oxlint/react/.oxlintrc.json",
    "./node_modules/ultracite/config/oxlint/next/.oxlintrc.json",
    "./node_modules/ultracite/config/oxlint/remix/.oxlintrc.json"
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "Bun": "readonly",
    "describe": "readonly",
    "it": "readonly",
    "expect": "readonly",
    "beforeEach": "readonly",
    "afterEach": "readonly",
    "beforeAll": "readonly",
    "afterAll": "readonly",
    "vi": "readonly",
    "jest": "readonly",
    "__DEV__": "readonly",
    "AudioWorkletProcessor": "readonly",
    "registerProcessor": "readonly"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "vendor/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.expo/**",
    "**/dev-dist/**",
    "**/.zed/**",
    "**/.vscode/**",
    "**/.wrangler/**",
    "**/.alchemy/**",
    "**/.svelte-kit/**",
    "**/.nuxt/**",
    "test-results/**",
    ".agent/**",
    ".agentfs/**"
  ],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "pedantic": "warn",
    "restriction": "warn",
    "nursery": "warn"
  },
  "rules": {
    "jest/require-hook": "off",
    "no-void": "warn",
    "no-template-curly-in-string": "error",
    "no-promise-executor-return": "warn",
    "import/first": "warn",
    "promise/avoid-new": "warn",
    "node/global-require": "warn",
    "no-explicit-any": "warn",
    "react-perf/jsx-no-new-function-as-prop": "warn",
    "import/no-named-as-default": "warn",
    "no-empty-function": "warn",
    "no-inline-comments": "warn",
    "unicorn/prefer-dom-node-dataset": "warn",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "complexity": "off",
    "arrow-body-style": "off",
    "func-style": "off",
    "import/consistent-type-specifier-style": "off",
    "jsdoc/check-tag-names": "off",
    "max-statements": "off",
    "sort-keys": "off",
    "oxc/no-barrel-file": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/__tests__/**",
        "**/*.test.tsx",
        "scripts/**",
        "**/*.config.ts",
        "**/*.config.js"
      ],
      "env": {
        "browser": true,
        "node": true
      },
      "rules": {
        "consistent-type-imports": "off",
        "import/first": "off",
        "jest/no-conditional-in-test": "off",
        "jest/prefer-hooks-in-order": "off",
        "no-explicit-any": "off",
        "no-empty-function": "off",
        "no-inline-comments": "off",
        "no-template-curly-in-string": "off",
        "no-non-null-assertion": "off",
        "promise/prefer-await-to-callbacks": "off",
        "promise/prefer-await-to-then": "off",
        "require-await": "off",
        "jest/prefer-spy-on": "off",
        "react-perf/jsx-no-new-function-as-prop": "off"
      }
    },
    {
      "files": [
        "apps/native/components/desktop/windows/cortex.tsx",
        "apps/native/components/form/Checkbox.tsx",
        "apps/native/components/form/Choice.tsx",
        "apps/native/components/genui/FormField.tsx",
        "apps/native/components/genui/Plan.tsx",
        "apps/native/lib/voice/session.ts",
        "apps/web/src/components/desktop/workflow-trails.tsx",
        "apps/web/src/components/shared/workflow-drawer.tsx",
        "apps/web/src/components/ui/orb.tsx",
        "apps/web/src/components/windows/workflow/workflow-window.tsx",
        "apps/web/src/hooks/use-assistant-stream.ts",
        "apps/web/src/hooks/use-voice-session-web.ts",
        "apps/web/src/routes/api/agentfs/download.ts",
        "packages/agent/src/orchestrator/learning/extract.ts",
        "packages/agent/src/orchestrator/tool/learning/index.ts",
        "packages/api/src/agentfscas.ts",
        "packages/api/src/routers/agentfs.ts",
        "packages/api/src/routers/agentfs/extra.ts",
        "packages/api/src/routers/agentfs/shared.ts",
        "packages/api/src/routers/workflow/phase/execute.ts",
        "packages/api/src/routers/workflow/stream.ts",
        "packages/api/src/services/agentfs-audit.ts",
        "packages/api/src/services/agentfs.ts",
        "packages/api/src/stream-handler.ts",
        "packages/codeprint/src/index.ts",
        "packages/db/src/repo/review.ts",
        "packages/history/src/history-context.ts",
        "packages/hooks/src/registry.ts",
        "packages/plan/src/generate/phased.ts",
        "packages/runtime/src/loops/cognitive.ts",
        "packages/runtime/src/orchestrator/agent.ts",
        "packages/tui/src/tui/react/dashboard.tsx",
        "packages/tui/src/tui/react/modes/debug.tsx",
        "packages/tui/src/tui/react/panels/agentfs.tsx",
        "packages/tui/src/tui/react/panels/toolcalls.tsx",
        "packages/tui/src/tui/react/panels/workflow.tsx",
        "scripts/verify-integration-health.ts"
      ],
      "rules": {
        "default-case": "off",
        "eslint-plugin-import/first": "off",
        "eslint-plugin-import/no-duplicates": "off",
        "eslint-plugin-promise/avoid-new": "off",
        "eslint-plugin-promise/no-promise-in-callback": "off",
        "eslint-plugin-promise/prefer-await-to-callbacks": "off",
        "eslint-plugin-promise/prefer-await-to-then": "off",
        "eslint-plugin-react-hooks/exhaustive-deps": "off",
        "eslint-plugin-react-perf/jsx-no-new-function-as-prop": "off",
        "eslint-plugin-react/jsx-no-useless-fragment": "off",
        "eslint-plugin-react/no-set-state": "off",
        "eslint-plugin-react/state-in-constructor": "off",
        "eslint-plugin-unicorn/filename-case": "off",
        "eslint-plugin-unicorn/no-array-for-each": "off",
        "eslint-plugin-unicorn/no-array-reduce": "off",
        "eslint-plugin-unicorn/no-lonely-if": "off",
        "eslint-plugin-unicorn/no-nested-ternary": "off",
        "eslint-plugin-unicorn/no-useless-collection-argument": "off",
        "eslint-plugin-unicorn/prefer-logical-operator-over-ternary": "off",
        "eslint-plugin-unicorn/prefer-math-trunc": "off",
        "eslint-plugin-unicorn/prefer-native-coercion-functions": "off",
        "eslint-plugin-unicorn/prefer-response-static-json": "off",
        "eslint-plugin-unicorn/prefer-spread": "off",
        "no-bitwise": "off",
        "no-duplicate-imports": "off",
        "no-empty": "off",
        "no-empty-function": "off",
        "no-inline-comments": "off",
        "no-negated-condition": "off",
        "no-nested-ternary": "off",
        "no-param-reassign": "off",
        "no-plusplus": "off",
        "no-promise-executor-return": "off",
        "no-unused-vars": "off",
        "no-useless-return": "off",
        "no-void": "off",
        "prefer-destructuring": "off",
        "prefer-template": "off",
        "require-await": "off",
        "typescript-eslint/consistent-type-imports": "off",
        "typescript-eslint/no-explicit-any": "off",
        "typescript-eslint/no-inferrable-types": "off",
        "typescript-eslint/no-non-null-assertion": "off"
      }
    }
  ],
  "$schema": "./node_modules/oxlint/configuration_schema.json"
}
