{
  "name": "native",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPatterns='test-jest/(components|hooks|lib)'",
    "test:integration": "jest --testPathPatterns='test-jest/integration'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "dev": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:simulator": "expo run:ios --device \"iPhone 15 Pro\"",
    "ios:build": "./scripts/build-optimized.sh",
    "ios:build:clean": "./scripts/build-optimized.sh --clean",
    "ios:build:fast": "./scripts/build-optimized.sh --no-launch",
    "simulator:setup": "./scripts/setup-simulator.sh",
    "prebuild": "expo prebuild",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@alfred/api": "workspace:*",
