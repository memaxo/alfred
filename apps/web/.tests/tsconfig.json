{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@playwright/test"],
    "moduleResolution": "bundler",
    "module": "Preserve",
    "target": "ES2022",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["../src/*"],
      "*": ["../../*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["../node_modules"]
}
