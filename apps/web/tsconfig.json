{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./.tsbuild/tsconfig.tsbuildinfo",
    "target": "ES2022",
    "module": "Preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "outDir": "./.tsbuild",
    "composite": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@alfred/api/*": ["../../packages/api/src/*"],
      "@alfred/auth/*": ["../../packages/auth/src/*"],
      "@alfred/db": ["../../packages/db/src/index.ts"],
      "@alfred/db/*": ["../../packages/db/src/*"],
      "@alfred/metrics/*": ["../../packages/metrics/src/*"],
      "@alfred/policy/*": ["../../packages/policy/src/*"],
      "@alfred/rag/*": ["../../packages/rag/src/*"],
      "@alfred/runtime/*": ["../../packages/runtime/src/*"],
      "@alfred/type/*": ["../../packages/type/src/*"],
      "@alfred/ui/*": ["../../packages/ui/src/*"],
      "@alfred/voice/*": ["../../packages/voice/src/*"]
    },
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "declaration": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", ".tsbuild"],
  "references": [
    {
      "path": "../../packages/api"
    },
    {
      "path": "../../packages/auth"
    },
    {
      "path": "../../packages/history"
    },
    {
      "path": "../../packages/voice"
    }
  ]
}
