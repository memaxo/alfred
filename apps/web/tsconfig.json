{
  "compilerOptions": {
    "tsBuildInfoFile": "./.tsbuild/tsconfig.tsbuildinfo",
    "target": "ES2022",
    "module": "Preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "outDir": "./.tsbuild",
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@alfred/pacer/react": ["../../packages/pacer/src/react.ts"],
      "@alfred/agent": ["../../packages/agent/src/index.ts"],
      "@alfred/agent/*": ["../../packages/agent/src/*"],
      "@alfred/api": ["../../packages/api/src/index.ts"],
      "@alfred/api/*": ["../../packages/api/src/*"],
      "@alfred/auth": ["../../packages/auth/src/index.ts"],
      "@alfred/api/test/*": ["../../packages/api/test/*"],
      "@alfred/auth/*": ["../../packages/auth/src/*"],
      "@alfred/codex": ["../../packages/codex/src/index.ts"],
      "@alfred/codex/*": ["../../packages/codex/src/*"],
      "@alfred/cognitive": ["../../packages/cognitive/src/index.ts"],
      "@alfred/cognitive/*": ["../../packages/cognitive/src/*"],
      "@alfred/cortex": ["../../packages/cortex/src/index.ts"],
      "@alfred/cortex/*": ["../../packages/cortex/src/*"],
      "@alfred/db": ["../../packages/db/src/index.ts"],
      "@alfred/db/*": ["../../packages/db/src/*"],
      "@alfred/embed": ["../../packages/embed/src/index.ts"],
      "@alfred/embed/*": ["../../packages/embed/src/*"],
      "@alfred/evals": ["../../packages/evals/src/index.ts"],
      "@alfred/evals/*": ["../../packages/evals/src/*"],
      "@alfred/history": ["../../packages/history/src/index.ts"],
      "@alfred/history/*": ["../../packages/history/src/*"],
      "@alfred/hooks": ["../../packages/hooks/src/index.ts"],
      "@alfred/hooks/*": ["../../packages/hooks/src/*"],
      "@alfred/home": ["../../packages/home/src/index.ts"],
      "@alfred/home/*": ["../../packages/home/src/*"],
      "@alfred/hookpipe": ["../../packages/hookpipe/src/index.ts"],
      "@alfred/hookpipe/*": ["../../packages/hookpipe/src/*"],
      "@alfred/knowledge": ["../../packages/knowledge/src/index.ts"],
      "@alfred/knowledge/*": ["../../packages/knowledge/src/*"],
      "@alfred/learning": ["../../packages/learning/src/index.ts"],
      "@alfred/learning/*": ["../../packages/learning/src/*"],
      "@alfred/logger": ["../../packages/logger/src/index.ts"],
      "@alfred/logger/*": ["../../packages/logger/src/*"],
      "@alfred/metrics/*": ["../../packages/metrics/src/*"],
      "@alfred/metrics": ["../../packages/metrics/src/index.ts"],
      "@alfred/pacer": ["../../packages/pacer/src/index.ts"],
      "@alfred/pacer/*": ["../../packages/pacer/src/*"],
      "@alfred/persona/*": ["../../packages/persona/src/*"],
      "@alfred/persona": ["../../packages/persona/src/index.ts"],
      "@alfred/pipeline": ["../../packages/pipeline/src/index.ts"],
      "@alfred/pipeline/*": ["../../packages/pipeline/src/*"],
      "@alfred/plan": ["../../packages/plan/src/index.ts"],
      "@alfred/plan/*": ["../../packages/plan/src/*"],
      "@alfred/protocol": ["../../packages/protocol/src/index.ts"],
      "@alfred/protocol/*": ["../../packages/protocol/src/*"],
      "@alfred/policy/*": ["../../packages/policy/src/*"],
      "@alfred/policy": ["../../packages/policy/src/index.ts"],
      "@alfred/rag/*": ["../../packages/rag/src/*"],
      "@alfred/rag": ["../../packages/rag/src/index.ts"],
      "@alfred/runtime/*": ["../../packages/runtime/src/*"],
      "@alfred/runtime": ["../../packages/runtime/src/index.ts"],
      "@alfred/sense": ["../../packages/sense/src/index.ts"],
      "@alfred/sense/*": ["../../packages/sense/src/*"],
      "@alfred/summarize": ["../../packages/summarize/src/index.ts"],
      "@alfred/summarize/*": ["../../packages/summarize/src/*"],
      "@alfred/type/*": ["../../packages/type/src/*"],
      "@alfred/type": ["../../packages/type/src/index.ts"],
      "@alfred/tui": ["../../packages/tui/src/index.ts"],
      "@alfred/tui/*": ["../../packages/tui/src/*"],
      "@alfred/test-kit": ["../../packages/test-kit/src/index.ts"],
      "@alfred/test-kit/*": ["../../packages/test-kit/src/*"],
      "@alfred/ui/*": ["../../packages/ui/src/*"],
      "@alfred/ui": ["../../packages/ui/src/index.ts"],
      "@alfred/voice/*": ["../../packages/voice/src/*"],
      "@alfred/voice": ["../../packages/voice/src/index.ts"],
      "*": ["./*"]
    },
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "../../packages/tsconfig/types/bun.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".tsbuild",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*"
  ]
}
