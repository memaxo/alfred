# ALFRED Environment Configuration
# Copy to .env and fill in values

# ============================================
# Database
# ============================================
# Production / dev Postgres URL used by runtime code paths.
# During `bun test`, you may omit this or set DATABASE_URL=sqlite::memory:
# to activate the in-memory SQLite mock recommended by Drizzle.
DATABASE_URL=postgresql://alfred:alfred@localhost:5432/alfred
# TODO: [Phase 3] Configure connection pooling (PGBOUNCER_URL)

# ============================================
# Auth (Better Auth + Passkeys)
# ============================================
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Passkey relies on WebAuthn relying party values derived from BETTER_AUTH_URL (hostname + origin)

# ============================================
# MCP/OIDC Clients (OAuth 2.1)
# ============================================
# Pre-registered OAuth clients for MCP integrations.
# These clients are trusted and skip consent for internal tools.
# Generate secrets with: openssl rand -base64 32

# Cursor IDE - MCP client for AI-assisted coding
# Register at: Settings > MCP > Add Client
CURSOR_CLIENT_ID=cursor-mcp-client
CURSOR_CLIENT_SECRET=your-cursor-client-secret

# Claude Desktop - MCP client for Anthropic's Claude
# Register at: Claude Desktop > Settings > MCP
CLAUDE_CLIENT_ID=claude-mcp-client
CLAUDE_CLIENT_SECRET=your-claude-client-secret

# Generic MCP Client (for custom integrations)
# MCP_CLIENT_ID=generic-mcp-client
# MCP_CLIENT_SECRET=your-generic-client-secret

# ============================================
# Test Modes
# ============================================
# When true, the web app injects a deterministic Better Auth bypass for Playwright + Vitest.
VITE_TEST_MODE=false
# Set to 1 to force Playwright to exercise the real Better Auth backend even when VITE_TEST_MODE=true.
PLAYWRIGHT_REAL_AUTH=0
# Mirrors PLAYWRIGHT_REAL_AUTH on the client so Vite bundles can detect the override.
VITE_PLAYWRIGHT_REAL_AUTH=0
# Enable integrated TanStack Devtools (alpha) with ALFRED-specific plugins.
VITE_DEVTOOLS=0
# Opt-in: run live provider smoke tests (incurs real network calls/cost).
# Default: 0 (offline-by-default tests).
ALFRED_LIVE_PROVIDER_TESTS=0

# ============================================
# Load Testing (workflow.start / workflow.stream)
# ============================================
# Base URL for load scripts (defaults to http://localhost:3000)
ALFRED_LOADTEST_BASE_URL=http://localhost:3000
# Concurrent in-flight requests (default: 10)
ALFRED_LOADTEST_CONCURRENCY=10
# Total number of runs (default: 100 for start, 50 for stream)
ALFRED_LOADTEST_REQUESTS=100
# Hard timeout for the load script (ms)
ALFRED_LOADTEST_TIMEOUT_MS=180000
# Per-stream timeout for workflow.stream (ms)
ALFRED_LOADTEST_STREAM_TIMEOUT_MS=120000
# Use real auth cookie instead of test-session header
# ALFRED_LOADTEST_COOKIE=
# Requirement prefix for generated runs
ALFRED_LOADTEST_REQUIRE_PREFIX=loadtest
# Autonomy level for load tests (read|low|medium|high)
ALFRED_LOADTEST_AUTO=low
# Optional projectId to attach runs
# ALFRED_LOADTEST_PROJECT_ID=
# Test user used for dev auth bypass
ALFRED_LOADTEST_TEST_USER_ID=loadtest-user
# Comma-separated scopes for dev auth bypass
ALFRED_LOADTEST_TEST_SCOPES=workflow.plan,workflow.stream,workflow.resume,workflow.read
# Validate workflow events persisted after stream completion (0/1)
ALFRED_LOADTEST_VERIFY_PERSISTED=0

# ============================================
# JARVIS Evolution
# ============================================
# Enable JARVIS persona enhancements (system prompt additions + voice openings).
ENABLE_JARVIS_PERSONA=false
# Opt-in: allow the web HUD to synthesize/play speech for notifications/greetings.
VITE_JARVIS_SPEAK=false

# ============================================
# Development Bypasses
# ============================================
# When true (development only), skips biometric/passkey verification for elevated operations.
# This allows development and CI without requiring hardware passkey setup.
# NEVER enabled in production - enforced in code (NODE_ENV=production ignores this flag).
BIO_AUTH_BYPASS=false

# ============================================
# Runtime Tool Graph (Act Phase)
# ============================================
# Limits parallel execution of independent tool-graph nodes (default: 4, clamped to 1..32).
RUNTIME_TOOL_GRAPH_MAX_PARALLEL=4
# Per-attempt linear backoff in milliseconds for retries (default: 25, clamped to 0..10000).
RUNTIME_TOOL_GRAPH_BACKOFF_MS=25

# ============================================
# agent-browser (UI automation)
# ============================================
# Optional override for the agent-browser CLI path.
# If unset, ALFRED tries `node_modules/.bin/agent-browser` then `agent-browser` from PATH.
# AGENT_BROWSER_BIN=/absolute/path/to/agent-browser

# ============================================
# Agent-to-Tool Tokens (Ed25519)
# ============================================
AGENT_ISSUER=alfred
AGENT_JWK_KID=agent-ed25519
AGENT_ED25519_PRIVATE=-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----
AGENT_ED25519_PUBLIC_PEM=-----BEGIN PUBLIC KEY-----\nyour-public-key\n-----END PUBLIC KEY-----
TOOL_AUDIENCE=alfred:tools
TOOL_TOKEN_TTL=300

# ============================================
# Redis (optional: biometric + token replay cache)
# ============================================
REDIS_URL=redis://localhost:6379
RUN_REGISTRY_BACKEND=memory
# Optional overrides for Redis-backed run registry
# INSTANCE_ID=
RUN_REGISTRY_ACK_TIMEOUT_MS=2000
RUN_REGISTRY_OWNER_TTL_SEC=120
RUN_REGISTRY_HEARTBEAT_MS=30000
# Redis connection retry configuration
REDIS_RETRY_ENABLED=true
REDIS_RETRY_INITIAL_DELAY_MS=100
REDIS_RETRY_MAX_DELAY_MS=5000
REDIS_RETRY_MAX_ATTEMPTS=5

# ============================================
# AI Models
# ============================================
# TODO: [Phase 4] Configure AI model providers
# The gateway API key used by `@ai-sdk/gateway` (preferred).
# Back-compat: `OPENAI_API_KEY` is also accepted as the gateway key.
# AI_GATEWAY_API_KEY=your-gateway-key
OPENAI_API_KEY=your-openai-key
# Cerebras (required when selecting any `cerebras:*` model refs)
CEREBRAS_API_KEY=your-cerebras-key
# OpenRouter (required when selecting any `openrouter:*` model refs)
OPENROUTER_API_KEY=your-openrouter-key

# Role-based model selection (canonical: `provider:modelId`).
# These resolve to stable `modelKey` values like `provider/modelId` for history budgeting + metrics.
# Aliases: `AI_MODEL_REF` and `AI_MODEL_REF_<ROLE>` (same format, higher precedence).
#
# Examples:
# AI_MODEL_CHAT=openrouter:anthropic/claude-3.5-sonnet
# AI_MODEL_ORCHESTRATOR=openrouter:anthropic/claude-3.5-sonnet
# AI_MODEL_PLANNER=cerebras:llama3.1-70b
# AI_MODEL_BACKGROUND=openai:gpt-4o-mini
# AI_MODEL_VOICE=cerebras:llama3.1-8b
#
# Safe defaults (OpenAI):
AI_MODEL_CHAT=openai:gpt-4o-mini
AI_MODEL_ORCHESTRATOR=openai:gpt-4o-mini
AI_MODEL_PLANNER=openai:gpt-4o
AI_MODEL_BACKGROUND=openai:gpt-4o-mini
AI_MODEL_VOICE=openai:gpt-4o-mini

# Legacy global override used by older call sites (expects `provider/modelId`).
# Prefer role-specific vars above.
AI_MODEL=openai/gpt-4o-mini

# AI SDK DevTools + Telemetry (optional)
# ============================================
# Local-only DevTools viewer (stores `.devtools/generations.json` in the repo root).
# Enable only in development environments.
# AI_DEVTOOLS=1
#
# OpenTelemetry spans for AI SDK calls (opt-in; ALFRED disables recording inputs/outputs by default).
# Requires an OpenTelemetry exporter configured in your runtime environment.
# AI_TELEMETRY=1
# Conversation history budgeting (token-aware selection)
HISTORY_CONTEXT_RATIO=0.5
HISTORY_MIN_SYSTEM_RESERVE=2000
HISTORY_MIN_HEADROOM=2000
# Optional JSON map overriding model context windows
# HISTORY_MODEL_CONTEXT={"openai/gpt-4o":128000,"openai/gpt-4o-mini":128000}
# Optional: override the OpenAI API base URL (e.g., Azure OpenAI)
# OPENAI_BASE_URL=https://example.openai.azure.com
# ANTHROPIC_API_KEY=your-anthropic-key

# ============================================
# Embeddings (RAG - Local KaLM Model)
# ============================================
# Local embedding model: KaLM-Embedding-Gemma3-12B-2511 (3840 dimensions)
# Requires: Python 3.10+, sentence-transformers, PyTorch with ROCm (Linux) or MPS (macOS)
# Installation: cd packages/embed && bun run install-deps && bun run download-model

# Number of embedding worker processes (default: 2)
EMBED_POOL_SIZE=2

# Device: "auto" (recommended), "cpu", "rocm", "mps"
# Auto-detection priority: mps > rocm > cuda > cpu
EMBED_DEVICE=auto

# Model name (HuggingFace Hub identifier)
EMBED_MODEL=tencent/KaLM-Embedding-Gemma3-12B-2511

# Python executable path (optional, defaults to UV > venv > system Python)
# EMBED_PYTHON_PATH=python3

# ============================================
# Embedding Queue & Batching
# ============================================
# Request queueing improves throughput by batching small requests
# and providing backpressure when workers are overloaded.

# Enable request queueing (default: 1)
EMBED_QUEUE_ENABLED=1

# Maximum pending requests before rejecting (default: 1000)
EMBED_QUEUE_MAX_SIZE=1000

# Maximum requests per batch (default: 32)
EMBED_BATCH_SIZE=32

# Maximum texts per batch (default: 64)
EMBED_BATCH_MAX_TEXTS=64

# Time to wait for more requests before processing (ms, default: 10)
EMBED_BATCH_DELAY_MS=10

# Maximum time a request can wait in queue (ms, default: 60000)
EMBED_QUEUE_TIMEOUT_MS=60000

# Retry failed batches (default: 3)
EMBED_RETRY_COUNT=3

# Initial retry delay (ms, doubles each retry, default: 100)
EMBED_RETRY_DELAY_MS=100

# ============================================
# Reranking (RAG - Multimodal Reranker)
# ============================================
# Reranking backend: "cohere" (SaaS), "qwen3vl" (self-hosted), "none" (disabled)
# Auto-detects based on COHERE_API_KEY or QWEN3VL_RERANK_URL if not set
# RERANK_BACKEND=auto

# Cohere API configuration (text-only reranking)
# COHERE_API_KEY=your-cohere-api-key
# COHERE_BASE_URL=https://api.cohere.ai

# Qwen3-VL Reranker (multimodal: text + images + video)
# URL to self-hosted reranker server (e.g., http://localhost:8200 or http://rerank:8000)
# QWEN3VL_RERANK_URL=http://localhost:8200

# Qwen3-VL server configuration (for Docker deployment)
# Device: "auto", "cpu", "cuda", "rocm", "mps"
RERANK_DEVICE=auto
# Model: HuggingFace model ID (2B or 8B variant)
RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
# Port for the rerank HTTP server
RERANK_PORT=8200
# Batch size for text-only documents (higher = faster but more memory)
RERANK_BATCH_SIZE=8
# Enable torch.compile for faster inference (recommended for CUDA)
# RERANK_COMPILE=1

# Debug/profiling (server)
# When enabled, the server can return per-stage timings (debug=true) and write cProfile dumps (profile=true).
# RERANK_DEBUG=1
# RERANK_PROFILE=1
# RERANK_PROFILE_DIR=./.agent/profiles/rerank

# Client configuration
# Request timeout in milliseconds (default: 30000)
# QWEN3VL_TIMEOUT_MS=30000
# Number of retries on transient failures (default: 2)
# QWEN3VL_RETRY_COUNT=2
# Retry delay multiplier in milliseconds (default: 500)
# QWEN3VL_RETRY_DELAY_MS=500
# Include server stage timings in responses (debug=true)
# QWEN3VL_DEBUG=1

# ============================================
# Observability
# ============================================
# Laminar tracing and evals
LMNR_PROJECT_API_KEY=your-laminar-key
# LMNR_BASE_URL=https://api.lmnr.ai
# LMNR_HTTP_PORT=443
# LMNR_GRPC_PORT=8443
# LMNR_TRACE_DISABLE_BATCH=0

# Evaluation defaults
EVALS_SAMPLING_RATE=0.1
EVAL_LAMINAR_EXPORT=0
EVAL_LAMINAR_MODE=sdk
# EVAL_LAMINAR_GROUP=alfred-evals

# TODO: [Phase 11] OTEL configuration
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ============================================
# Integrations
# ============================================

# Cursor CLI (for CI/CD automation)
# Required for GitHub Actions workflows: cursor-automation.yml
# Get your API key from: https://cursor.com/settings/api
CURSOR_API_KEY=your-cursor-api-key

# Linear
# TODO: [Phase 7] Linear OAuth configuration
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret
LINEAR_WEBHOOK_SECRET=your-webhook-secret
LINEAR_REDIRECT_URI=http://localhost:3000/api/linear/callback

# Home Automation Provider
# Provider: "homeassistant" (recommended), "fake" (disabled)
# Home Assistant requires a long-lived access token from:
# Settings > Security > Long-Lived Access Tokens
HOME_PROVIDER=homeassistant
HOME_BASE_URL=http://homeassistant.local:8123
HOME_TOKEN=your-home-assistant-long-lived-token
# Optional: SSL verification (default: true)
HOME_VERIFY_SSL=true
# Optional: Request timeout in milliseconds (default: 5000)
HOME_TIMEOUT_MS=5000

# ============================================
# Infrastructure (Proxmox)
# ============================================
# TODO: [Phase 10] Proxmox API configuration
PROXMOX_HOST=proxmox.local
# API token ID format: user@realm!tokenid (e.g. alfred@pve!alfred)
PROXMOX_TOKEN_ID=alfred@pve!alfred
PROXMOX_TOKEN_SECRET=your-proxmox-token
PROXMOX_NODE=pve

# Provisioning defaults for `scripts/proxmox.ts`
PROXMOX_OSTEMPLATE=local:vztmpl/ubuntu-22.04-standard_*.tar.zst
PROXMOX_STORAGE=local-lvm
PROXMOX_BRIDGE=vmbr0
PROXMOX_GATEWAY=192.168.1.1
PROXMOX_CIDR=24

PROXMOX_ALFRED_VMID=120
PROXMOX_DB_VMID=121
PROXMOX_REDIS_VMID=122

PROXMOX_ALFRED_IP=192.168.1.120
PROXMOX_DB_IP=192.168.1.121
PROXMOX_REDIS_IP=192.168.1.122

# Optional: full net0 overrides (bypass bridge/gateway/cidr/ip assembly)
# PROXMOX_NET0_ALFRED=name=eth0,bridge=vmbr0,ip=192.168.1.120/24,gw=192.168.1.1
# PROXMOX_NET0_DB=name=eth0,bridge=vmbr0,ip=192.168.1.121/24,gw=192.168.1.1
# PROXMOX_NET0_REDIS=name=eth0,bridge=vmbr0,ip=192.168.1.122/24,gw=192.168.1.1

# Optional: LXC root password (some templates require this at create time)
# PROXMOX_LXC_PASSWORD=change-me

# Optional: health verification (once ALFRED is deployed and running in the server container)
PROXMOX_ALFRED_PORT=3000
# PROXMOX_ALFRED_URL=http://192.168.1.120:3000
PROXMOX_VERIFY_ATTEMPTS=15
PROXMOX_VERIFY_TIMEOUT_MS=2000
PROXMOX_VERIFY_DELAY_MS=1000

# ============================================
# Reverse Proxy (Caddy)
# ============================================
CADDY_ADMIN_URL=http://127.0.0.1:2019

# ============================================
# Deploy (Docker previews)
# ============================================
# Base domain for preview/production routes, e.g., preview.apps.example.com
APP_DOMAIN=alfred.local
# Optional overrides for Docker binary and network to use for preview containers
DOCKER_BIN=/usr/bin/docker
DOCKER_NETWORK=bridge
PREVIEW_PORT_START=30080
PREVIEW_PORT_END=30200

# ============================================
# Workflow Runtime (Phase 3.3)
# ============================================
# NOTE: Workflow execution currently uses `@alfred/runtime` via
# `@alfred/agent/workflow/services` regardless of this flag.
# TODO: Either re-introduce a real toggle or remove this var once rollout is complete.
USE_WORKFLOW_RUNTIME=false

# Workflow recovery (restart)
# Max runs to scan on API boot (default: 200)
WORKFLOW_RECOVERY_MAX=200
# When RUN_REGISTRY_BACKEND != redis, mark stale "running" runs as failed on restart.
# Grace window in ms to avoid racing newly-started runs (default: 60000)
WORKFLOW_RUNNING_RECOVERY_GRACE_MS=60000

# Model for workflow planning (overrides AI_MODEL for orchestrator)
# OPENAI_MODEL_PLAN=gpt-4o

# ============================================
# Stuck Detection Thresholds
# ============================================
# Time without events before agent is considered stuck (ms, default: 120000 = 2 minutes)
# Increase for complex/long-running tasks, decrease for faster feedback
# STUCK_NO_PROGRESS_MS=60000
# Consecutive identical commands that indicate stuck state (default: 5)
# Increase for iterative tasks requiring multiple test/fix cycles
# STUCK_MAX_REPEATS=5
# Same file modifications before considered flip-flopping (default: 4)
# Increase for refactoring tasks that touch the same files repeatedly
# STUCK_MAX_FILE_FLIP_FLOPS=4

# ============================================
# Orchestrator Sandbox
# ============================================
# Restrict git/droid working directories (absolute paths, colon separated)
ORCH_ALLOW_CWD_PREFIXES=/Users/alfred/Development
# Preferred web search provider (exa|ddg|serpapi|tavily). Defaults to exa when EXA_API_KEY is set.
ORCH_WEB_PROVIDER=
# Web tool fetch limits (bytes for raw fetch fallback)
WEB_FETCH_MAX_BYTES=200000
# DuckDuckGo is default fallback when no provider specified.
WEB_SEARCH_PROVIDER=ddg
# Exa API configuration (optional)
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_TIMEOUT_MS=20000

# Optional overrides
# DROID_BIN=/usr/local/bin/droid
FACTORY_API_KEY=your-factory-api-key
ORCH_EXECUTOR=droid
ORCH_EXECUTOR_FALLBACK=1
# ORCH_EXECUTOR_SHADOW=0
CODEX_BIN=codex
CODEX_PROFILE=alfred
CODEX_API_KEY=your-codex-api-key
ORCH_CODEX_ALLOW_OPENAI_KEY=1
# Background learning worker (async knowledge extraction loop)
ENABLE_LEARNING_WORKER=0
ENABLE_DB_RECOVERY=0
# Public dashboard host for workflow runs (optional)
ORCHESTRATOR_RUN_BASE_URL=https://alfred.local/orchestrator

# Persist non-stream generate results (assistant/orchestrator) for replay
# Set to 1 to enable durable storage of generate outputs
ENABLE_GENERATE_PERSIST=0

# Deterministic event identity for workflow events (optional)
# When enabled, event_id will be a SHA-256 hash of (runId|type|data) to support
# deterministic replays and easier deduplication across processes.
# Default: 0 (use UUIDs)
DETERMINISTIC_EVENT_IDS=0

# ============================================
# API Module Auto-Init (Tooling / CLI)
# ============================================
# @alfred/api auto-initializes background services (including voice pools) on import.
# For tooling contexts (like `alfred --help`) that must be instant and side-effect-free,
# prefer importing routers from `@alfred/api/router`.
# As an escape hatch, set this to "false" to disable auto-init in `@alfred/api` entirely.
ALFRED_API_AUTO_INIT=true

# ============================================
# Pipeline Architecture (Feature Flag)
# ============================================
# Enable the new canonical pipeline architecture for workflow execution.
# When set to "1", orchestrateWorkflowStream routes all workflows through @alfred/pipeline.
# When unset or "0", uses legacy orchestrator in packages/runtime/src/phases/.
# Default: disabled (legacy orchestrator)
# ALFRED_USE_PIPELINE=1

# ============================================
# Reasoning Memory
# ============================================
COMPRESSION_ENABLED=true
COMPRESSION_INTERVAL_MS=3600000
COMPRESSION_HALF_LIFE_MS=604800000
COMPRESSION_MIN_CONFIDENCE=0.3
COMPRESSION_MAX_AGE_MS=2592000000
REASONING_MIN_LENGTH=10
REASONING_MAX_STORED=1000
REASONING_CONFIDENCE_BASE=0.7

# ============================================
# Memory Maintenance (Forgetting Curve)
# ============================================
MEMORY_DECAY_ENABLED=true
# How often to run memory maintenance (default: 1 hour)
MEMORY_DECAY_INTERVAL_MS=3600000
# Age threshold for decaying confidence (default: 24 hours)
MEMORY_DECAY_THRESHOLD_MS=86400000
# Multiplier for decaying confidence (default: 0.95)
MEMORY_DECAY_FACTOR=0.95
# Threshold for pruning low-confidence memories (default: 0.2)
MEMORY_PRUNE_CONFIDENCE=0.2
# Age threshold for hard deletion of archived memories (default: 30 days)
MEMORY_CLEANUP_AGE_MS=2592000000

# ============================================
# Voice (STT/TTS)
# ============================================
# TTS provider: "maya1" (default) or "supertonic" (ONNX TTS)
VOICE_PROVIDER=maya1
VOICE_STREAMING_PROTO=0
VOICE_STREAMING_PORT=8788
# WebSocket rate limiting (voice streaming)
VOICE_WS_RATE_LIMIT_PER_IP=10
VOICE_WS_RATE_LIMIT_PER_USER=5

# ============================================
# STT Configuration (Nemotron Speech ASR)
# ============================================
# STT model: Nemotron Speech 0.6B (default) - 600M params, native punctuation, cache-aware streaming
# Alternative: nvidia/parakeet_realtime_eou_120m-v1 (120M params, lower accuracy, no punctuation)
VOICE_STT_MODEL=nvidia/nemotron-speech-streaming-en-0.6b
# Device: "cuda", "mps" (Apple Silicon), "rocm" (AMD GPU), or "cpu" (auto-detects if not set)
VOICE_STT_DEVICE=auto
# Chunk size for latency/accuracy tradeoff:
#   - "fast": 80ms chunks, lowest latency (real-time feedback)
#   - "low": 160ms chunks (voice assistants)
#   - "medium": 560ms chunks (balanced, default)
#   - "accurate": 1.12s chunks (highest accuracy, transcription tasks)
VOICE_STT_CHUNK_SIZE=medium
# Process pool size for STT workers
VOICE_STT_POOL_SIZE=2

# Legacy STT variables (deprecated, use VOICE_STT_* instead)
# WHISPER_MODEL_PATH=nvidia/nemotron-speech-streaming-en-0.6b
# WHISPER_DEVICE=auto

# ============================================
# TTS Configuration (Maya1 / Supertonic)
# ============================================
VOICE_TTS_MODEL=maya1
VOICE_TTS_VOICE=en_US-lessac-medium
# TTS Provider: "maya1" (default) or "supertonic" (lightweight, onnx)
TTS_PROVIDER=maya1
# Process pool size for TTS workers
VOICE_TTS_POOL_SIZE=2

# Piper TTS (used by Maya1 legacy path) model directory and voice
PIPER_MODEL_PATH=./packages/voice/models/piper
PIPER_VOICE=en_US-lessac-medium

# Supertonic model directory (optional override, defaults to packages/voice/models/supertonic)
# SUPERTONIC_MODEL_PATH=./packages/voice/models/supertonic

# ============================================
# SSE Connection Limits
# ============================================
# Maximum SSE connections per user (default: 5)
SSE_MAX_CONNECTIONS_PER_USER=5
# Maximum global SSE connections (default: 100)
SSE_MAX_GLOBAL_CONNECTIONS=100
# SSE connection timeout in milliseconds (default: 1800000 = 30 minutes)
SSE_CONNECTION_TIMEOUT_MS=1800000
# SSE connection rate limit per minute per user (default: 10)
SSE_RATE_LIMIT_PER_MINUTE=10

# Python executable path (defaults to "python3")
# PYTHON_PATH=python3

# UV integration (auto-detected if not set)
# Set to "false" to disable UV usage and use system Python
# VOICE_USE_UV=true

# ============================================
# Tailscale (SSH ACL Management - Optional)
# ============================================
# Tailscale API key for programmatic ACL management
# Create at: https://login.tailscale.com/admin/settings/keys
# Required scope: policy_file (read and write)
# TAILSCALE_API_KEY=tskey-api-...
# Tailnet name or '-' for default tailnet
# Find at: https://login.tailscale.com/admin/settings/general
# TAILNET_NAME=memaxo.github

# ============================================
# Development
# ============================================
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
