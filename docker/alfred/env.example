# Minimal env for Docker Compose.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Database
POSTGRES_USER=alfred
POSTGRES_PASSWORD=alfred
POSTGRES_DB=alfred
DATABASE_URL=postgres://alfred:alfred@pg:5432/alfred

# Redis (optional profile)
REDIS_URL=redis://redis:6379

# ============================================
# AgentFS (optional schedulers)
# ============================================
# SCHED_AGENTFS_CLEANUP=0
# SCHED_AGENTFS_INTEGRITY=0
# SCHED_AGENTFS_COMPACT=0
# ALFRED_AGENTFS_RETENTION_DAYS=14
# ALFRED_AGENTFS_CAS_RETENTION_DAYS=30
# ALFRED_AGENTFS_COMPACT_VACUUM=0

# ============================================
# Local LLM (vllm-mlx on host) - Optional
# ============================================
# Use this when you run `vllm-mlx serve ...` on the *host* Mac and want the
# Docker `alfred` service to talk to it.
#
# vllm-mlx exposes an OpenAI-compatible server at:
# - http://<host>:8000/v1/chat/completions
# - http://<host>:8000/v1/models
# - http://<host>:8000/health
#
# Inside Docker, the host is reachable at `host.docker.internal`.
#
# IMPORTANT:
# - Leave AI_GATEWAY_API_KEY unset so ALFRED uses the OpenAI-compatible client.
# - If you start vllm-mlx with `--api-key`, set LOCAL_OPENAI_API_KEY to the same value.
#
# Example host command (Apple Silicon):
#   vllm-mlx serve mlx-community/GLM-4.7-Flash-8bit-gs32 \
#     --host 0.0.0.0 --port 8000 \
#     --continuous-batching --use-paged-cache \
#     --api-key your-secret-key
#
# Local OpenAI-compatible endpoint for provider `local:...`.
# LOCAL_OPENAI_BASE_URL=http://host.docker.internal:8000/v1
# LOCAL_OPENAI_API_KEY=your-secret-key
#
# Route ALFRED roles to the local model. Provider must be `local:` (ALFRED model ref).
# AI_MODEL_CHAT=local:mlx-community/GLM-4.7-Flash-8bit-gs32
# AI_MODEL_ORCHESTRATOR=local:mlx-community/GLM-4.7-Flash-8bit-gs32
# AI_MODEL_PLANNER=local:mlx-community/GLM-4.7-Flash-8bit-gs32
#
# Lightweight/background-only example (recommended for small local models like LFM2.5):
# AI_MODEL_BACKGROUND=local:LiquidAI/LFM2.5-1.2B-Thinking-MLX-8bit

# ============================================
# Voice WebRTC (optional)
# ============================================
# Enable WebRTC signaling in the API (SRTP Opus primary transport).
# VOICE_WEBRTC_PROTO=1
#
# ICE servers given to browsers/native clients.
# For local dev with the `turn` service:
# - start it with: `docker compose --profile turn up -d turn`
# - use your machine's LAN IP (or localhost for same-machine testing)
#
# Example (STUN + local TURN):
# VOICE_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:localhost:3478?transport=udp"],"username":"alfred","credential":"alfred"}]

# ============================================
# Reranking (optional: requires rerank profile)
# ============================================
#
# Enable reranking inside RAG retrieval paths (default: 0)
# RAG_RERANK=0
#
# Prefer the self-hosted Qwen3-VL reranker inside docker-compose network:
# QWEN3VL_RERANK_URL=http://rerank:8000
#
# Or configure Cohere reranking instead:
# COHERE_API_KEY=your-cohere-api-key
#
# Optional: force backend selection ("cohere" | "qwen3vl" | "none")
# RERANK_BACKEND=

# ============================================
# TUI (Terminal UI)
# ============================================
# TUI runs on the HOST (not in Docker), so it can access vllm-mlx directly on localhost.
# No need for host.docker.internal when running TUI on host.
#
# Start vllm-mlx on host:
#   vllm-mlx serve mlx-community/GLM-4.7-Flash-8bit-gs32 \
#     --host 0.0.0.0 --port 8000 \
#     --continuous-batching --use-paged-cache \
#     --api-key your-secret-key
#
# Run TUI with MLX model:
#   VLLM_MLX_BASE_URL=http://localhost:8000/v1 VLLM_MLX_API_KEY=your-secret-key \
#     alfred tui chat
