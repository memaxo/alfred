# Minimal env for Docker Compose.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Database
POSTGRES_USER=alfred
POSTGRES_PASSWORD=alfred
POSTGRES_DB=alfred
DATABASE_URL=postgres://alfred:alfred@pg:5432/alfred

# Redis (optional profile)
REDIS_URL=redis://redis:6379

# ============================================
# Voice WebRTC (optional)
# ============================================
# Enable WebRTC signaling in the API (SRTP Opus primary transport).
# VOICE_WEBRTC_PROTO=1
#
# ICE servers given to browsers/native clients.
# For local dev with the `turn` service:
# - start it with: `docker compose --profile turn up -d turn`
# - use your machine's LAN IP (or localhost for same-machine testing)
#
# Example (STUN + local TURN):
# VOICE_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:localhost:3478?transport=udp"],"username":"alfred","credential":"alfred"}]

# ============================================
# Reranking (optional: requires rerank profile)
# ============================================
#
# Enable reranking inside RAG retrieval paths (default: 0)
# RAG_RERANK=0
#
# Prefer the self-hosted Qwen3-VL reranker inside docker-compose network:
# QWEN3VL_RERANK_URL=http://rerank:8000
#
# Or configure Cohere reranking instead:
# COHERE_API_KEY=your-cohere-api-key
#
# Optional: force backend selection ("cohere" | "qwen3vl" | "none")
# RERANK_BACKEND=
