{
  "dashboard": {
    "title": "ALFRED Workflow Runner",
    "panels": [
      {
        "type": "graph",
        "title": "Stream Events",
        "targets": [
          { "expr": "workflow_stream_events_total" }
        ]
      },
      {
        "type": "graph",
        "title": "Stream Duration (s)",
        "targets": [
          { "expr": "histogram_quantile(0.95, sum(rate(workflow_stream_duration_seconds_bucket[5m])) by (le))" }
        ]
      },
      {
        "type": "graph",
        "title": "Runner Steps",
        "targets": [
          { "expr": "workflow_runner_steps_total" }
        ]
      },
      {
        "type": "graph",
        "title": "Replay Queries",
        "targets": [
          { "expr": "workflow_replay_queries_total" }
        ]
      }
    ]
  }
}

