version: "3.9"

services:
  pg:
    image: pgvector/pgvector:pg16
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 10

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    profiles: ["redis"]
    ports:
      - "6379:6379"
    volumes:
      - redisdata:/data

  alfred:
    image: alfred:latest
    restart: unless-stopped
    depends_on:
      pg:
        condition: service_healthy
    env_file:
      - .env
    ports:
      - "{{ alfred_port }}:3000"

  embed:
    image: alfred-embed:latest
    restart: unless-stopped
    profiles: ["embed"]
    environment:
      EMBED_DEVICE: ${EMBED_DEVICE}
    volumes:
      - embed_models:/app/packages/embed/models

  voice:
    image: alfred-voice:latest
    restart: unless-stopped
    profiles: ["voice"]
    environment:
      VOICE_DEVICE: ${VOICE_DEVICE}
    volumes:
      - voice_models:/app/packages/voice/models

volumes:
  pgdata:
  redisdata:
  embed_models:
  voice_models:
