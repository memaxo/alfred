NODE_ENV={{ alfred_node_env }}
HOST=0.0.0.0
PORT={{ alfred_port }}

# Database
POSTGRES_USER={{ alfred_db_user }}
POSTGRES_PASSWORD={{ alfred_db_password }}
POSTGRES_DB={{ alfred_db_name }}
DATABASE_URL=postgres://{{ alfred_db_user }}:{{ alfred_db_password }}@pg:5432/{{ alfred_db_name }}

# Redis
REDIS_URL={{ alfred_redis_url }}

# Specialized Runtimes
EMBED_DEVICE={{ embed_device | default('cpu') }}
VOICE_DEVICE={{ voice_device | default('cpu') }}
