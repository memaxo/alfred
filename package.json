{
  "name": "alfred",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.0.2",
      "@trpc/server": "^11.6.0",
      "@trpc/client": "^11.6.0",
      "@trpc/react-query": "^11.6.0",
      "ai": "^6.0.0-beta.94",
      "@ai-sdk/google": "^2.0.13",
      "@ai-sdk/openai": "^2.0.49",
      "@ai-sdk/cohere": "^2.0.0",
      "better-auth": "^1.3.13",
      "drizzle-orm": "^0.44.2",
      "dotenv": "^17.2.2",
      "tsdown": "^0.15.5",
      "@lmnr-ai/lmnr": "^0.7.4"
    }
  },
  "scripts": {
    "check": "biome check --write .",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --nested",
    "ruler:verify": "bunx @intellectronica/ruler@latest apply --no-gitignore --nested && git diff --exit-code",
    "ci": "turbo run typecheck test",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "tsc -b --pretty false",
    "typecheck:workspace": "turbo typecheck",
    "check:budgets": "bun scripts/check-budgets.ts",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @alfred/db db:push",
    "db:studio": "turbo -F @alfred/db db:studio",
    "db:generate": "turbo -F @alfred/db db:generate",
    "db:migrate": "turbo -F @alfred/db db:migrate",
    "db:start": "turbo -F @alfred/db db:start",
    "db:watch": "turbo -F @alfred/db db:watch",
    "db:stop": "turbo -F @alfred/db db:stop",
    "db:down": "turbo -F @alfred/db db:down"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/bun": "^1.3.2",
    "@types/node": "^22.13.11",
    "bun-types": "^1.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "tsdown": "^0.15.5",
    "turbo": "^2.5.4",
    "typescript": "^5.7.2",
    "ultracite": "5.6.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "packageManager": "bun@1.2.18"
}
