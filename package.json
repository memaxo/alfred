{
  "name": "alfred",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.0.2",
      "@trpc/server": "^11.6.0",
      "@trpc/client": "^11.6.0",
      "@trpc/react-query": "^11.6.0",
      "ai": "^6.0.0-beta.137",
      "@ai-sdk/react": "^3.0.0-beta.138",
      "@ai-sdk/google": "^2.0.44",
      "@ai-sdk/openai": "^2.0.77",
      "@ai-sdk/cohere": "^2.0.20",
      "better-auth": "1.4.7",
      "drizzle-orm": "^0.44.2",
      "dotenv": "^17.2.2",
      "playwright": "^1.49.1",
      "tsdown": "^0.15.5",
      "@lmnr-ai/lmnr": "^0.7.4"
    }
  },
  "scripts": {
    "test": "bun scripts/test-bun.ts",
    "check": "biome check --write .",
    "lint": "bunx biome check .",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --nested",
    "ruler:verify": "bunx @intellectronica/ruler@latest apply --no-gitignore --nested && git diff --exit-code",
    "setup": "bun install && turbo run setup",
    "verify:build": "bun scripts/verify-build.ts",
    "preflight": "bun scripts/preflight.ts",
    "check:artifacts": "bun scripts/check-artifacts.ts",
    "codex:build": "bun scripts/build-codex.ts",
    "ci": "bun run check:artifacts && turbo run typecheck && bun run test:sqlite && bun run test:postgres && bun run test:integration && bun run test:workflow-integration && bun run smoke:hypergraph",
    "dev": "turbo dev",
    "dev:debug": "bun --inspect run dev",
    "dev:debug:web": "bun --inspect run dev:web",
    "dev:debug:api": "bun --inspect run --filter @alfred/api dev",
    "debug:test": "bun --inspect-brk test",
    "debug:script": "bun --inspect-brk",
    "build": "NODE_OPTIONS='--max-old-space-size=16384' turbo build",
    "build:executable": "bun scripts/build-executable.sh",
    "build:executable:dev": "NODE_ENV=development bun scripts/build-executable.sh",
    "build:executable:prod": "NODE_ENV=production bun scripts/build-executable.sh",
    "build:profile": "bun scripts/profile-build.ts",
    "build:profile:api": "bun scripts/profile-build.ts --cwd packages/api --label api",
    "typecheck": "tsc -b --pretty false",
    "typecheck:workspace": "turbo typecheck",
    "tune:run": "bun run packages/tune/src/cli.ts",
    "check:budgets": "bun scripts/check-budgets.ts",
    "test:perf": "bun test packages/cognitive/test/performance-budget.test.ts packages/knowledge/test/extractor.perf.test.ts packages/knowledge/test/hypergraph.perf.test.ts packages/agent/test/multi/performance.test.ts packages/runtime/test/performance.test.ts",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @alfred/db db:push",
    "db:studio": "turbo -F @alfred/db db:studio",
    "db:generate": "turbo -F @alfred/db db:generate",
    "db:migrate": "turbo -F @alfred/db db:migrate",
    "db:start": "turbo -F @alfred/db db:start",
    "db:watch": "turbo -F @alfred/db db:watch",
    "db:stop": "turbo -F @alfred/db db:stop",
    "db:down": "turbo -F @alfred/db db:down",
    "install:poof": "bash scripts/install-poof.sh",
    "test:sqlite": "turbo run test --cache-dir .turbo/sqlite",
    "test:postgres": "turbo run test:postgres --cache-dir .turbo/postgres",
    "test:integration": "bun test packages/knowledge/test/hypergraph.integration.test.ts packages/agent/assistant/test/graphstore.integration.test.ts packages/api/test/graph.integration.test.ts packages/api/test/workflow.reasoning.integration.test.ts packages/api/test/workflow.capture.integration.test.ts packages/agent/test/multi/*.test.ts packages/agent/test/multi-agent.integration.test.ts",
    "test:integration:postgres": "RUN_DB_TESTS=1 bun test packages/api/test/integration/*.postgres.test.ts packages/api/test/integration/postgres-features.integration.test.ts",
    "test:workflow-integration": "bun test packages/api/test/utils/workflow-server.test.ts packages/api/test/workflow.stream.integration.test.ts apps/web/src/routes/api/__tests__/workflow.stream.integration.test.ts",
    "smoke:hypergraph": "bun scripts/smoke-hypergraph.ts",
    "smoke:stt": "bun scripts/voice/test-stt.ts",
    "smoke:tts": "bun scripts/voice/test-tts.ts",
    "test:mindscape:smoke": "bunx playwright test --config apps/web/playwright.config.ts --project=smoke",
    "test:mindscape:integration": "bunx playwright test --config apps/web/playwright.config.ts --project=integration",
    "test:mindscape:e2e": "bunx playwright test --config apps/web/playwright.config.ts --project=e2e",
    "test:mindscape:all": "bunx playwright test --config apps/web/playwright.config.ts",
    "test:web:smoke:prod": "bunx playwright test --config apps/web/playwright.prod.config.ts --project=prod-smoke",
    "test:integration:full": "bun test packages/api/test/integration/*.integration.test.ts",
    "test:vcr:record": "VCR_RECORD=1 bun run test:integration:full",
    "test:vcr:validate": "bun scripts/validate-cassettes.ts",
    "workflow:cleanup": "bun packages/api/src/workers/workflow-suspension-cleanup.ts"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.3.6",
    "ajv": "^8.17.1",
    "dotenv": "^17.2.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@playwright/test": "^1.49.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.4",
    "@types/node": "^22.13.11",
    "bun-types": "^1.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "playwright": "^1.49.1",
    "tsdown": "^0.15.5",
    "turbo": "^2.5.4",
    "typescript": "^5.7.2",
    "ultracite": "5.6.1",
    "node-gyp": "12.1.0",
    "ws": "^8.18.3",
    "sucrase": "^3.35.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "packageManager": "bun@1.3.5"
}
