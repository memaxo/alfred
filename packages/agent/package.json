{
  "name": "@alfred/agent",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./integrations/*": {
      "types": "./src/integrations/*.ts",
      "bun": "./src/integrations/*.ts",
      "default": "./src/integrations/*.ts"
    },
    "./orchestrator/*": {
      "types": "./src/orchestrator/*.ts",
      "bun": "./src/orchestrator/*.ts",
      "default": "./src/orchestrator/*.ts"
    },
    "./orchestrator/tool/shared": {
      "types": "./src/orchestrator/tool/shared/index.ts",
      "bun": "./src/orchestrator/tool/shared/index.ts",
      "default": "./src/orchestrator/tool/shared/index.ts"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "bun": "./src/utils/*.ts",
      "default": "./src/utils/*.ts"
    },
    "./workflow/*": {
      "types": "./src/workflow/*.ts",
      "bun": "./src/workflow/*.ts",
      "default": "./src/workflow/*.ts"
    },
    "./eval/metrics": {
      "types": "./src/eval/metrics.ts",
      "bun": "./src/eval/metrics.ts",
      "default": "./src/eval/metrics.ts"
    },
    "./assistant/src/adapter": {
      "types": "./src/assistant/src/adapter.ts",
      "bun": "./src/assistant/src/adapter.ts",
      "default": "./src/assistant/src/adapter.ts"
    },
    "./assistant/src/jarvis-persona": {
      "types": "./src/assistant/src/jarvis-persona.ts",
      "bun": "./src/assistant/src/jarvis-persona.ts",
      "default": "./src/assistant/src/jarvis-persona.ts"
    },
    "./services/*": {
      "types": "./src/services/*.ts",
      "bun": "./src/services/*.ts",
      "default": "./src/services/*.ts"
    },
    "./assistant/*": {
      "types": "./assistant/src/*.ts",
      "bun": "./assistant/src/*.ts",
      "default": "./assistant/src/*.ts"
    },
    "./signals/*": {
      "types": "./src/signals/*.ts",
      "bun": "./src/signals/*.ts",
      "default": "./src/signals/*.ts"
    }
  },
  "scripts": {
    "test": "bun ../../scripts/test-bun.ts --timeout 60000 --preload ../test-kit/src/bun/preload.ts --preload ./test/utils/sandbox.ts",
    "typecheck": "tsgo -b",
    "build": "tsgo -b --emitDeclarationOnly",
    "build:bundle": "bun build ./src/index.ts --outdir ./dist/bundle --target=bun",
    "build:bundle:dev": "bun build --feature=LEGACY_WORKTREE ./src/index.ts --outdir ./dist/bundle-dev --target=bun"
  },
  "dependencies": {
    "@ai-sdk/cerebras": "^1.0.8",
    "@ai-sdk/devtools": "^0.0.4",
    "@ai-sdk/mcp": "^1.0.5",
    "@ai-sdk/openai": "^2.0.49",
    "@ai-sdk/openai-compatible": "^2.0.18",
    "@alfred/auth": "workspace:*",
    "@alfred/codex": "workspace:*",
    "@alfred/cognitive": "workspace:*",
    "@alfred/db": "workspace:*",
    "@alfred/embed": "workspace:*",
    "@alfred/home": "workspace:*",
    "@alfred/hooks": "workspace:*",
    "@alfred/knowledge": "workspace:*",
    "@alfred/learning": "workspace:*",
    "@alfred/logger": "workspace:*",
    "@alfred/metrics": "workspace:*",
    "@alfred/persona": "workspace:*",
    "@alfred/plan": "workspace:*",
    "@alfred/policy": "workspace:*",
    "@alfred/protocol": "workspace:*",
    "@alfred/type": "workspace:*",
    "@linear/sdk": "^53.0.0",
    "@lmnr-ai/lmnr": "^0.7.4",
    "@opencode-ai/sdk": "^1.1.49",
    "@openrouter/ai-sdk-provider": "^0.0.5",
    "agentfs-sdk": "^0.3.1",
    "exa-js": "^2.0.12",
    "lru-cache": "^11.0.1",
    "oxc-parser": "^0.98.0",
    "p-retry": "6.2.0",
    "playwright": "catalog:",
    "prom-client": "^15.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {},
  "peerDependencies": {
    "typescript": "^5"
  }
}
