{
  "name": "@alfred/agent",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./assistant/*": {
      "types": "./assistant/src/*.ts",
      "default": "./assistant/src/*.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "test": "bun test"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@alfred/auth": "workspace:*",
    "@ai-sdk/openai": "^2.0.49",
    "@lmnr-ai/lmnr": "^0.7.4",
    "@linear/sdk": "^53.0.0",
    "@alfred/cognitive": "workspace:*",
    "@alfred/knowledge": "workspace:*",
    "@alfred/learning": "workspace:*",
    "p-retry": "^6.2.0",
    "zod": "catalog:"
  }
}
