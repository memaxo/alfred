{
  "name": "@alfred/api",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test": "bun test --preload ./test/utils/mock-metrics.ts --preload ./test/utils/mock-db-client.ts --preload ./test/utils/mock-voice.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/google": "catalog:",
    "@alfred/agent": "workspace:*",
    "@alfred/auth": "workspace:*",
    "@alfred/db": "workspace:*",
    "@alfred/runtime": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "node-pty": "^1.0.0",
    "prom-client": "^15.1.3",
    "zod": "catalog:"
  }
}
