{
  "name": "@alfred/api",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    },
    "./trpc-internal": {
      "types": "./dist/trpc-internal.d.ts",
      "default": "./src/trpc-internal.ts"
    }
  },
  "type": "module",
  "sideEffects": [
    "**/init.ts",
    "**/index.ts",
    "**/metrics.ts"
  ],
  "scripts": {
    "build": "tsc -b --emitDeclarationOnly",
    "test": "ALFRED_TEST_ISOLATE_FILES=1 ALFRED_TEST_ISOLATE_CONCURRENCY=2 ALFRED_TEST_FILE_TIMEOUT_MS=60000 bun ../../scripts/test-bun.ts --timeout 60000 --preload ../test-kit/src/bun/preload.ts --preload ./test/utils/sandbox.ts --preload ./test/utils/mock-metrics.ts --preload ./test/utils/mock-db-client.ts --preload ./test/utils/mock-voice.ts",
    "test:postgres": "RUN_DB_TESTS=1 ALFRED_TEST_ISOLATE_FILES=1 ALFRED_TEST_ISOLATE_CONCURRENCY=2 ALFRED_TEST_FILE_TIMEOUT_MS=60000 bun ../../scripts/test-bun.ts --timeout 60000 --preload ../test-kit/src/bun/preload.ts --preload ./test/utils/sandbox.ts --preload ./test/utils/mock-metrics.ts --preload ./test/utils/mock-db-client.ts --preload ./test/utils/mock-voice.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {},
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/google": "catalog:",
    "@alfred/agent": "workspace:*",
    "@alfred/auth": "workspace:*",
    "@alfred/embed": "workspace:*",
    "@alfred/logger": "workspace:*",
    "@alfred/db": "workspace:*",
    "@alfred/metrics": "workspace:*",
    "@alfred/plan": "workspace:*",
    "@alfred/policy": "workspace:*",
    "@alfred/tune": "workspace:*",
    "@alfred/runtime": "workspace:*",
    "@alfred/voice": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "prom-client": "^15.1.3",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
