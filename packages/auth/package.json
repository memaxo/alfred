    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "better-auth": "catalog:",
    "@better-auth/expo": "^1.3.13",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@alfred/db": "workspace:*",
    "jose": "^5.2.1",
    "nanoid": "^5.0.7",
    "redis": "^4.7.0"
  }
}
