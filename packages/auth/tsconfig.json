{
  "extends": "@alfred/tsconfig/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "composite": true,
    "rootDir": "./src",
    "strictNullChecks": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["dist", "**/*.test.ts"],
  "references": [
    { "path": "../db" },
    { "path": "../logger" },
    { "path": "../metrics" },
    { "path": "../policy" }
  ]
}
