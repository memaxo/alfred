{
  "name": "@alfred/cortex",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./src/engine.ts"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "default": "./src/math/index.ts"
    },
    "./coordinate": {
      "types": "./dist/coordinate.d.ts",
      "default": "./src/coordinate.ts"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./src/presets.ts"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./src/config.ts"
    },
    "./systems/*": {
      "types": "./dist/systems/*.d.ts",
      "default": "./src/systems/*.ts"
    },
    "./fallback/*": {
      "types": "./dist/fallback/*.d.ts",
      "default": "./src/fallback/*.ts"
    }
  },
  "scripts": {
    "build": "tsgo -b",
    "dev": "tsgo -b -w",
    "lint": "biome check .",
    "check-types": "tsgo --noEmit",
    "typecheck": "tsgo -b",
    "test": "bun ../../scripts/test-bun.ts --timeout 60000 --preload ../test-kit/src/bun/preload.ts"
  },
  "dependencies": {
    "@alfred/embed": "workspace:*",
    "@alfred/type": "workspace:*"
  },
  "devDependencies": {
    "@alfred/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
