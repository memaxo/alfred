{
  "name": "@alfred/db",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "default": "./dist/browser.js",
        "import": "./dist/browser.js"
      },
      "bun": "./src/index.ts",
      "default": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "bun": "./src/*.ts",
      "default": "./dist/*.js",
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./browser": {
      "default": "./dist/browser.js",
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./client": {
      "default": "./dist/client.js",
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./repo/deploy": {
      "bun": "./src/repo/deploy/index.ts",
      "default": "./dist/repo/deploy/index.js",
      "import": "./dist/repo/deploy/index.js",
      "types": "./dist/repo/deploy/index.d.ts"
    },
    "./repo/graph": {
      "bun": "./src/repo/graph/index.ts",
      "default": "./dist/repo/graph/index.js",
      "import": "./dist/repo/graph/index.js",
      "types": "./dist/repo/graph/index.d.ts"
    },
    "./repo/graph/read": {
      "bun": "./src/repo/graph/read.ts",
      "default": "./dist/repo/graph/read.js",
      "import": "./dist/repo/graph/read.js",
      "types": "./dist/repo/graph/read.d.ts"
    },
    "./repo/graph/write": {
      "bun": "./src/repo/graph/write.ts",
      "default": "./dist/repo/graph/write.js",
      "import": "./dist/repo/graph/write.js",
      "types": "./dist/repo/graph/write.d.ts"
    },
    "./repo/graph/scoring": {
      "bun": "./src/repo/graph/scoring.ts",
      "default": "./dist/repo/graph/scoring.js",
      "import": "./dist/repo/graph/scoring.js",
      "types": "./dist/repo/graph/scoring.d.ts"
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "default": "./dist/testing.js",
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -b --emitDeclarationOnly",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "bun scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:start": "bun scripts/compose.ts up -d",
    "db:stop": "bun scripts/compose.ts stop",
    "db:watch": "bun scripts/compose.ts up",
    "db:down": "bun scripts/compose.ts down",
    "test": "bun test",
    "test:postgres": "RUN_DB_TESTS=1 bun test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@alfred/logger": "workspace:*",
    "@alfred/metrics": "workspace:*",
    "@alfred/type": "workspace:*",
    "drizzle-orm": "catalog:",
    "prom-client": "^15.1.3",
    "pg": "^8.14.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.2",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
