{
  "extends": "@alfred/tsconfig/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "composite": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "**/*.test.ts"],
  "references": [
    { "path": "../embed" },
    { "path": "../type" },
    { "path": "../logger" },
    { "path": "../metrics" }
  ]
}
