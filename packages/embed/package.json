{
  "name": "@alfred/embed",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./src/types.ts"
    },
    "./pool": {
      "types": "./dist/pool.d.ts",
      "default": "./src/pool.ts"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./src/process.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "typecheck": "tsc -b",
    "test": "bun ../../scripts/test-bun.ts --timeout 60000 --preload ../test-kit/src/bun/preload.ts",
    "install-deps": "bash scripts/install-deps.sh",
    "download-model": "uv run python scripts/download_model.py"
  }
}
