{
  "id": "toolheavy",
  "modelId": "openai/gpt-4o-mini",
  "maxContextTokens": 16000,
  "system": {
    "persona": "You are ALFRED.",
    "preferences": "Never output internal refs. Summarize large tool results.",
    "domain": ""
  },
  "rag": [],
  "tools": [
    {
      "name": "core_git",
      "kind": "core",
      "description": "Runs git commands",
      "schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "workdir": { "type": "string" }
        }
      }
    },
    {
      "name": "mcp__bigschema",
      "kind": "mcp",
      "description": "[mcp:demo] Example MCP tool with a huge schema",
      "schema": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "a": { "type": "string" },
              "b": { "type": "string" },
              "c": { "type": "string" },
              "d": { "type": "string" },
              "e": { "type": "string" },
              "f": { "type": "string" },
              "g": { "type": "string" },
              "h": { "type": "string" },
              "i": { "type": "string" },
              "j": { "type": "string" }
            }
          }
        }
      }
    }
  ],
  "messages": [
    {
      "id": "t-001",
      "role": "user",
      "parts": [
        {
          "type": "text",
          "text": "Show me the last 200 lines of the server log."
        }
      ]
    },
    {
      "id": "t-002",
      "role": "assistant",
      "parts": [
        {
          "type": "tool-call",
          "toolCallId": "call-1",
          "toolName": "core_git",
          "input": { "command": "git status" }
        }
      ]
    },
    {
      "id": "t-003",
      "role": "assistant",
      "parts": [
        {
          "type": "tool-result",
          "toolCallId": "call-1",
          "toolName": "core_git",
          "output": {
            "exitCode": 0,
            "stdout": {
              "__repeat": {
                "line": "LINE: example log entry",
                "count": 12000
              }
            },
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "t-004",
      "role": "assistant",
      "parts": [{ "type": "text", "text": "Here's the log excerpt." }]
    }
  ]
}
