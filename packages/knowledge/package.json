{
  "name": "@alfred/knowledge",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./compression": {
      "types": "./dist/compression.d.ts",
      "default": "./src/compression.ts"
    },
    "./entity": {
      "types": "./dist/entity.d.ts",
      "default": "./src/entity.ts"
    },
    "./extractor": {
      "types": "./dist/extractor.d.ts",
      "default": "./src/extractor.ts"
    },
    "./lexicon": {
      "types": "./dist/lexicon/index.d.ts",
      "default": "./src/lexicon/index.ts"
    },
    "./lexicon/titles": {
      "types": "./dist/lexicon/titles.d.ts",
      "default": "./src/lexicon/titles.ts"
    },
    "./lexicon/antonyms": {
      "types": "./dist/lexicon/antonyms.d.ts",
      "default": "./src/lexicon/antonyms.ts"
    },
    "./lexicon/code": {
      "types": "./dist/lexicon/code.d.ts",
      "default": "./src/lexicon/code.ts"
    },
    "./lexicon/domains": {
      "types": "./dist/lexicon/domains.d.ts",
      "default": "./src/lexicon/domains.ts"
    },
    "./extract/entities": {
      "types": "./dist/extract/entities.d.ts",
      "default": "./src/extract/entities.ts"
    },
    "./hypergraph": {
      "types": "./dist/hypergraph.d.ts",
      "default": "./src/hypergraph.ts"
    },
    "./indices/*": {
      "types": "./dist/indices/*.d.ts",
      "default": "./src/indices/*.ts"
    },
    "./ontology": {
      "types": "./dist/ontology.d.ts",
      "default": "./src/ontology.ts"
    },
    "./persist": {
      "types": "./dist/persist.d.ts",
      "default": "./src/persist.ts"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./src/query.ts"
    },
    "./graph.hot": {
      "types": "./dist/graph.hot.d.ts",
      "default": "./src/graph.hot.ts"
    },
    "./query.hot": {
      "types": "./dist/query.hot.d.ts",
      "default": "./src/query.hot.ts"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "default": "./src/metrics.ts"
    },
    "./reasoning/causality": {
      "types": "./dist/reasoning/causality.d.ts",
      "default": "./src/reasoning/causality.ts"
    },
    "./reasoning/decisions": {
      "types": "./dist/reasoning/decisions.d.ts",
      "default": "./src/reasoning/decisions.ts"
    },
    "./reasoning/alternatives": {
      "types": "./dist/reasoning/alternatives.d.ts",
      "default": "./src/reasoning/alternatives.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "test": "bun test"
  },
  "dependencies": {
    "@alfred/db": "workspace:*",
    "@alfred/embed": "workspace:*",
    "@alfred/logger": "workspace:*",
    "@alfred/metrics": "workspace:*",
    "@alfred/type": "workspace:*",
    "chrono-node": "^2.9.0",
    "compromise": "^14.14.4",
    "drizzle-orm": "catalog:",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "*"
  }
}
