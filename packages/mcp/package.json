{
  "name": "@alfred/mcp",
  "version": "0.1.0",
  "description": "ALFRED runtime MCP server (minimal control-plane tools)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "build": "tsgo -b",
    "dev": "tsgo -b -w",
    "typecheck": "tsgo -b --pretty false",
    "test": "bun ../../scripts/test-bun.ts --timeout 60000 --preload ../test-kit/src/bun/preload.ts"
  },
  "dependencies": {
    "@alfred/auth": "workspace:*",
    "@alfred/logger": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "*"
  }
}
