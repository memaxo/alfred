{
  "name": "@alfred/metrics",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/shared.ts",
    "**/registry.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./genui": {
      "types": "./dist/genui.d.ts",
      "default": "./src/genui.ts"
    },
    "./classification": {
      "types": "./dist/classification.d.ts",
      "default": "./src/classification.ts"
    },
    "./performance": {
      "types": "./dist/performance.d.ts",
      "default": "./src/performance.ts"
    },
    "./cognitive": {
      "types": "./dist/cognitive.d.ts",
      "default": "./src/cognitive.ts"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./src/registry.ts"
    },
    "./default": {
      "types": "./dist/default.d.ts",
      "default": "./src/default.ts"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "default": "./src/shared.ts"
    },
    "./token": {
      "types": "./dist/token.d.ts",
      "default": "./src/token.ts"
    }
  },
  "scripts": {
    "build": "tsgo -b",
    "dev": "tsgo -b -w",
    "lint": "biome check .",
    "check-types": "tsgo --noEmit",
    "typecheck": "tsgo -b"
  },
  "dependencies": {
    "@alfred/logger": "workspace:*",
    "@alfred/type": "workspace:*",
    "prom-client": "^15.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alfred/tsconfig": "workspace:*",
    "typescript": "^5.7.2"
  }
}
