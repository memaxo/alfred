{
  "name": "@alfred/metrics",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": ["**/shared.ts", "**/registry.ts"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./performance": {
      "types": "./dist/performance.d.ts",
      "default": "./src/performance.ts"
    },
    "./cognitive": {
      "types": "./dist/cognitive.d.ts",
      "default": "./src/cognitive.ts"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./src/registry.ts"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "default": "./src/shared.ts"
    },
    "./token": {
      "types": "./dist/token.d.ts",
      "default": "./src/token.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@alfred/type": "workspace:*",
    "@alfred/logger": "workspace:*",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@alfred/tsconfig": "workspace:*",
    "typescript": "^5.7.2"
  }
}
