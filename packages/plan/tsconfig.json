{
  "extends": "@alfred/tsconfig/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/plan.tsbuildinfo",
    "declaration": true,
    "declarationMap": false,
    "composite": true,
    "paths": {
      "*": ["./*"]
    },
    "strictNullChecks": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/*"],
  "references": [
    {
      "path": "../type"
    },
    {
      "path": "../agent"
    },
    {
      "path": "../knowledge"
    },
    {
      "path": "../db"
    }
  ]
}
