{
  "name": "@alfred/rag",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsgo -b --clean && tsgo -b --emitDeclarationOnly",
    "dev": "tsgo -b --watch",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix .",
    "check-types": "tsgo --noEmit",
    "typecheck": "tsgo -b --emitDeclarationOnly --pretty false"
  },
  "dependencies": {
    "@ai-sdk/cohere": "^2.0.0",
    "@alfred/db": "workspace:*",
    "@alfred/embed": "workspace:*",
    "@alfred/knowledge": "workspace:*",
    "@alfred/rerank": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alfred/tsconfig": "workspace:*",
    "typescript": "^5.7.2"
  }
}
