{
  "name": "@alfred/runtime",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "dev": "echo 'Skipping runtime dev watch'",
    "typecheck": "tsc -b --pretty false",
    "test": "ALFRED_TEST_ISOLATE_FILES=1 ALFRED_TEST_ISOLATE_CONCURRENCY=2 ALFRED_TEST_WATCHDOG_MS=60000 bun ../../scripts/test-bun.ts --timeout 60000 --preload ../test-kit/src/bun/preload.ts --preload ./test/utils/sandbox.ts --max-concurrency=1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    },
    "./trajectory/*": {
      "types": "./dist/trajectory/*.d.ts",
      "default": "./src/trajectory/*.ts"
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@alfred/agent": "workspace:*",
    "@alfred/auth": "workspace:*",
    "@alfred/cognitive": "workspace:*",
    "@alfred/db": "workspace:*",
    "@alfred/history": "workspace:*",
    "@alfred/knowledge": "workspace:*",
    "@alfred/learning": "workspace:*",
    "@alfred/logger": "workspace:*",
    "@alfred/mcp": "workspace:*",
    "@alfred/plan": "workspace:*",
    "@alfred/policy": "workspace:*",
    "@alfred/rag": "workspace:*",
    "@alfred/rerank": "workspace:*",
    "@alfred/type": "workspace:*",
    "@trpc/server": "catalog:",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "prom-client": "^15.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "*"
  }
}
