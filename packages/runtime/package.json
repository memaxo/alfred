{
  "name": "@alfred/runtime",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "dev": "echo 'Skipping runtime dev watch'",
    "typecheck": "tsc -b --pretty false",
    "test": "bun test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@alfred/cognitive": "workspace:*",
    "@alfred/db": "workspace:*",
    "@alfred/knowledge": "workspace:*",
    "@alfred/learning": "workspace:*",
    "@alfred/logger": "workspace:*",
    "@alfred/policy": "workspace:*",
    "@alfred/type": "workspace:*",
    "@alfred/agent": "workspace:*",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "*"
  }
}
