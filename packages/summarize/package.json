{
  "name": "@alfred/summarize",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./src/process.ts"
    }
  },
  "scripts": {
    "build": "tsgo -b",
    "dev": "tsgo -b -w",
    "lint": "biome check .",
    "check-types": "tsgo --noEmit",
    "typecheck": "tsgo -b --pretty false",
    "python:install": "uv sync",
    "python:check": "uv run python -c \"from python.compressor import LongCodeZip; print('OK')\""
  },
  "dependencies": {
    "@alfred/logger": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alfred/tsconfig": "workspace:*",
    "typescript": "^5.7.2"
  }
}
