{
  "extends": "@alfred/tsconfig/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/summarize.tsbuildinfo",
    "declaration": true,
    "declarationMap": false,
    "composite": true,
    "paths": {
      "zod": ["../../node_modules/zod/index.d.cts"],
      "*": ["./*"]
    },
    "strictNullChecks": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test/**/*", "python/**/*"],
  "references": []
}
