{
  "name": "@alfred/test-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./kinetic": "./src/kinetic/index.ts",
    "./cognitive": "./src/cognitive/index.ts",
    "./physical": "./src/physical/index.ts",
    "./env": "./src/env/index.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/token": "./src/auth/token.ts",
    "./auth/session": "./src/auth/session.ts",
    "./auth/*": "./src/auth/*",
    "./logger": "./src/logger/index.ts",
    "./redis": "./src/redis/index.ts",
    "./vcr": "./src/vcr/index.ts",
    "./vcr/*": "./src/vcr/*",
    "./codex": "./src/codex/index.ts",
    "./codex/*": "./src/codex/*",
    "./voice": "./src/voice/index.ts",
    "./voice/*": "./src/voice/*",
    "./voice/runtime-fixture": "./src/voice/runtime-fixture.ts",
    "./workflow": "./src/workflow/runtime-fixture.ts",
    "./workflow/*": "./src/workflow/*",
    "./workflow/runtime-fixture": "./src/workflow/runtime-fixture.ts"
  },
  "scripts": {
    "test": "bun ../../scripts/test-bun.ts --timeout 60000 --preload ./src/bun/preload.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@alfred/agent": "workspace:*",
    "@alfred/db": "workspace:*",
    "@alfred/logger": "workspace:*",
    "@alfred/runtime": "workspace:*",
    "@alfred/type": "workspace:*",
    "@alfred/voice": "workspace:*",
    "ai": "catalog:",
    "jose": "^6.0.11",
    "testcontainers": "^10.16.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@alfred/auth": "workspace:*"
  }
}
