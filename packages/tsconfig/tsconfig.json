{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "ESNext"],
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "typeRoots": ["./types", "../../node_modules/@types"],
    "paths": {
      "@alfred/api/*": ["../api/src/*"],
      "@alfred/auth/*": ["../auth/src/*"],
      "@alfred/policy/*": ["../policy/src/*"],
      "@alfred/db/*": ["../db/src/*"],
      "@alfred/hooks": ["../hooks/src/index.ts"],
      "@alfred/hooks/*": ["../hooks/src/*"],
      "@alfred/hookpipe": ["../hookpipe/src/index.ts"],
      "@alfred/hookpipe/*": ["../hookpipe/src/*"],
      "@alfred/home": ["../home/src/index.ts"],
      "@alfred/home/*": ["../home/src/*"],
      "@alfred/pacer": ["../pacer/src/index.ts"],
      "@alfred/pacer/react": ["../pacer/src/react.ts"],
      "@alfred/pacer/*": ["../pacer/src/*"],
      "@alfred/rag/*": ["../rag/src/*"],
      "@alfred/ui/*": ["../ui/src/*"],
      "@alfred/type/*": ["../type/src/*"],
      "@alfred/agent/*": ["../agent/src/*"],
      "@alfred/codex": ["../codex/src/index.ts"],
      "@alfred/codex/*": ["../codex/src/*"],
      "@alfred/cognitive/*": ["../cognitive/src/*"],
      "@alfred/knowledge/*": ["../knowledge/src/*"],
      "@alfred/learning/*": ["../learning/src/*"],
      "@alfred/metrics/*": ["../metrics/src/*"],
      "@alfred/runtime/*": ["../runtime/src/*"],
      "zod": ["../../node_modules/zod/index.d.cts"],
      "*": ["./*"]
    }
  }
}
