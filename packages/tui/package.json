{
  "name": "@alfred/tui",
  "version": "0.1.0",
  "private": true,
  "description": "Unified CLI/TUI infrastructure for ALFRED",
  "bin": {
    "alfred": "./src/bin/alfred.ts"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "bun": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsgo -b",
    "dev": "tsgo -b -w",
    "typecheck": "tsgo -b --pretty false",
    "test": "bun ../../scripts/test-bun.ts --timeout 60000 --preload ../test-kit/src/bun/preload.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.49",
    "@ai-sdk/openai-compatible": "^2.0.18",
    "@alfred/api": "workspace:*",
    "@alfred/auth": "workspace:*",
    "@alfred/logger": "workspace:*",
    "@alfred/persona": "workspace:*",
    "@alfred/type": "workspace:*",
    "@inquirer/prompts": "^7.5.0",
    "@opentui/core": "^0.1.23",
    "@opentui/react": "^0.1.63",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "omelette": "^0.4.17",
    "trpc-cli": "^0.12.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alfred/tsconfig": "workspace:*",
    "typescript": "^5.9.3"
  }
}
