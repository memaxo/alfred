{
  "name": "@alfred/ui",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./chat/parts": {
      "types": "./dist/chat/parts.d.ts",
      "default": "./src/chat/parts.ts"
    },
    "./genui": {
      "types": "./dist/genui/index.d.ts",
      "default": "./src/genui/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsgo -b --emitDeclarationOnly",
    "typecheck": "tsgo -b",
    "test": "bun ../../scripts/test-bun.ts --timeout 60000 --preload ../test-kit/src/bun/preload.ts"
  },
  "dependencies": {
    "@alfred/type": "workspace:*"
  },
  "devDependencies": {},
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
