# syntax=docker/dockerfile:1
# Base image with ROCm support (PyTorch 2.1+ for AMD)
FROM rocm/pytorch:rocm6.0_ubuntu22.04_py3.10_pytorch_2.1.2

WORKDIR /app

# Install system dependencies
# soundfile needs libsndfile1
RUN apt-get update && apt-get install -y \
    libsndfile1 \
    ffmpeg \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast package management
ENV UV_LINK_MODE=copy
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:$PATH"

# Create virtual environment
RUN uv venv .venv

# Copy dependency files
COPY packages/voice/pyproject.rocm.toml ./packages/voice/pyproject.toml
COPY packages/voice/uv.lock ./packages/voice/uv.lock

# Sync dependencies
# Generate a lockfile in-image from the ROCm pyproject, then sync.
# This ensures PyTorch comes from the ROCm index declared in pyproject.
WORKDIR /app/packages/voice
RUN uv lock && uv sync --frozen --no-install-project

# Smoke check: verify Python deps import without loading models
RUN .venv/bin/python -c "import torch, transformers, snac, soundfile, nemo.collections.asr; print('deps_ok')"

# Copy source code
COPY packages/voice/python ./python
COPY packages/voice/src ./src
COPY packages/voice/scripts ./scripts
COPY packages/voice/package.json ./package.json

# Create entrypoint script
RUN echo '#!/bin/bash\n\
source .venv/bin/activate\n\
export PYTHONPATH=$PYTHONPATH:$(pwd)/python\n\
# Default to Maya1 (no args) or use args if provided\n\
python -m python.tts.server "$@"\n\
' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Expose models directory (should be mounted as volume for persistence)
VOLUME /app/packages/voice/models

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV MAYA_QUANTIZE_4BIT=true

ENTRYPOINT ["/app/entrypoint.sh"]
