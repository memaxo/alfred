{
  "name": "@alfred/voice",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "**/metrics.ts"
  ],
  "scripts": {
    "dev": "tsgo -b -w",
    "build": "tsgo -b",
    "typecheck": "tsgo -b",
    "test": "bun ../../scripts/test-bun.ts --timeout 60000 --preload ../test-kit/src/bun/preload.ts",
    "install-deps": "bash scripts/install.sh",
    "download-models": "uv run python scripts/download.py",
    "verify": "uv run python scripts/download.py --verify-only",
    "verify:python": "bun run scripts/verify-python.ts",
    "repair:python": "bun run scripts/repair-python.ts",
    "setup": "bash scripts/install.sh && uv run python scripts/download.py",
    "setup:ci": "uv sync --frozen && uv run python scripts/download.py",
    "download-supertonic": "bash scripts/supertonic.sh"
  },
  "peerDependencies": {
    "@alfred/type": "workspace:*",
    "@trpc/client": "^11.6.0"
  },
  "dependencies": {
    "@alfred/db": "workspace:*",
    "@alfred/logger": "workspace:*",
    "@alfred/metrics": "workspace:*",
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@discordjs/opus": "^0.10.0",
    "onnxruntime-node": "^1.23.2",
    "piper-wasm": "^0.1.4",
    "prom-client": "^15.1.3"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./src/types.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./src/types.ts"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./src/session.ts"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "default": "./src/stream.ts"
    },
    "./server/session": {
      "types": "./dist/server/session.d.ts",
      "default": "./src/server/session.ts"
    },
    "./server/registry": {
      "types": "./dist/server/registry.d.ts",
      "default": "./src/server/registry.ts"
    },
    "./server/socket": {
      "types": "./dist/server/socket.d.ts",
      "default": "./src/server/socket.ts"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "default": "./src/audio/index.ts"
    },
    "./audio/codec": {
      "types": "./dist/audio/codec.d.ts",
      "default": "./src/audio/codec.ts"
    },
    "./audio/opus": {
      "types": "./dist/audio/opus.d.ts",
      "default": "./src/audio/opus.ts"
    },
    "./audio/converter": {
      "types": "./dist/audio/converter.d.ts",
      "default": "./src/audio/converter.ts"
    },
    "./process/base": {
      "types": "./dist/process/base.d.ts",
      "default": "./src/process/base.ts"
    },
    "./process/ipc": {
      "types": "./dist/process/ipc.d.ts",
      "default": "./src/process/ipc.ts"
    },
    "./process/pool-manager": {
      "types": "./dist/process/pool-manager.d.ts",
      "default": "./src/process/pool-manager.ts"
    },
    "./process/stt": {
      "types": "./dist/process/stt.d.ts",
      "default": "./src/process/stt.ts"
    },
    "./process/tts": {
      "types": "./dist/process/tts.d.ts",
      "default": "./src/process/tts.ts"
    },
    "./process/supertonic": {
      "types": "./dist/process/supertonic.d.ts",
      "default": "./src/process/supertonic.ts"
    },
    "./transport": {
      "types": "./dist/transport/trpc.d.ts",
      "default": "./src/transport/trpc.ts"
    },
    "./adapters/web": {
      "types": "./dist/adapters/web.d.ts",
      "default": "./src/adapters/web.ts"
    },
    "./adapters/native": {
      "types": "./dist/adapters/native.d.ts",
      "default": "./src/adapters/native.ts"
    },
    "./test/utils/python-helpers": {
      "types": "./test/utils/python-helpers.d.ts",
      "default": "./test/utils/python-helpers.ts"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "default": "./src/metrics.ts"
    },
    "./services/config": {
      "types": "./dist/services/config.d.ts",
      "default": "./src/services/config.ts"
    },
    "./services/models": {
      "types": "./dist/services/models.d.ts",
      "default": "./src/services/models.ts"
    },
    "./services/stt": {
      "types": "./dist/services/stt.d.ts",
      "default": "./src/services/stt.ts"
    },
    "./services/tts": {
      "types": "./dist/services/tts.d.ts",
      "default": "./src/services/tts.ts"
    }
  }
}
