{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@alfred/agent": ["packages/agent/src/index.ts"],
      "@alfred/agent/*": ["packages/agent/src/*"],
      "@alfred/api": ["packages/api/src/index.ts"],
      "@alfred/api/*": ["packages/api/src/*"],
      "@alfred/auth": ["packages/auth/src/index.ts"],
      "@alfred/auth/*": ["packages/auth/src/*"],
      "@alfred/db": ["packages/db/src/index.ts"],
      "@alfred/db/*": ["packages/db/src/*"],
      "@alfred/history": ["packages/history/src/index.ts"],
      "@alfred/history/*": ["packages/history/src/*"],
      "@alfred/knowledge": ["packages/knowledge/src/index.ts"],
      "@alfred/knowledge/*": ["packages/knowledge/src/*"],
      "@alfred/logger": ["packages/logger/src/index.ts"],
      "@alfred/logger/*": ["packages/logger/src/*"],
      "@alfred/metrics": ["packages/metrics/src/index.ts"],
      "@alfred/metrics/*": ["packages/metrics/src/*"],
      "@alfred/policy": ["packages/policy/src/index.ts"],
      "@alfred/policy/*": ["packages/policy/src/*"],
      "@alfred/rag": ["packages/rag/src/index.ts"],
      "@alfred/rag/*": ["packages/rag/src/*"],
      "@alfred/runtime": ["packages/runtime/src/index.ts"],
      "@alfred/runtime/*": ["packages/runtime/src/*"],
      "@alfred/type": ["packages/type/src/index.ts"],
      "@alfred/type/*": ["packages/type/src/*"],
      "@alfred/ui": ["packages/ui/src/index.ts"],
      "@alfred/ui/*": ["packages/ui/src/*"],
      "@alfred/voice": ["packages/voice/src/index.ts"],
      "@alfred/voice/*": ["packages/voice/src/*"],
      "@alfred/test-kit": ["packages/test-kit/src/index.ts"],
      "@alfred/test-kit/*": ["packages/test-kit/src/*"]
    }
  }
}
