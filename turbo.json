{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "boundaries": {
    "tags": {
      "server-only": {
        "dependents": {
          "deny": ["client"]
        }
      },
      "client": {
        "dependencies": {
          "deny": ["server-only"]
        }
      },
      "core": {
        "dependents": {
          "allow": ["server-only", "core", "client", "app"]
        }
      },
      "app": {
        "dependencies": {
          "allow": ["server-only", "core", "client", "app"]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/*.test.ts",
        "!**/*.spec.ts",
        "!**/test/**",
        "!**/__tests__/**"
      ],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"],
      "passThroughEnv": ["NODE_OPTIONS"]
    },
    "//#lint": {
      "inputs": ["**/*.{ts,tsx,js,jsx,json,jsonc}"],
      "outputs": []
    },
    "//#lint:fix": {
      "cache": false
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".oxlintrc.json",
        ".oxfmtrc.jsonc",
        "../../.oxlintrc.json",
        "../../.oxfmtrc.jsonc"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "outputs": ["*.tsbuildinfo", "dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/test/**",
        "**/__tests__/**"
      ],
      "outputs": [],
      "env": [
        "ALFRED_TEST_SCOPE",
        "ALFRED_TEST_TIMEOUT_MS",
        "ALFRED_TEST_WATCHDOG_MS",
        "ALFRED_TEST_RUN_TIMEOUT_MS",
        "ALFRED_TEST_FILE_TIMEOUT_MS",
        "ALFRED_TEST_RUNNER_TIMEOUT_MS",
        "RUN_DB_TESTS",
        "NODE_ENV",
        "VITE_TEST_MODE"
      ]
    },
    "test:postgres": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "env": [
        "ALFRED_TEST_SCOPE",
        "ALFRED_TEST_TIMEOUT_MS",
        "ALFRED_TEST_WATCHDOG_MS",
        "ALFRED_TEST_RUN_TIMEOUT_MS",
        "ALFRED_TEST_FILE_TIMEOUT_MS",
        "ALFRED_TEST_RUNNER_TIMEOUT_MS",
        "RUN_DB_TESTS",
        "DATABASE_URL",
        "NODE_ENV"
      ]
    },
    "setup": {
      "cache": false,
      "persistent": false
    },
    "migrate": {
      "cache": false,
      "persistent": true
    },
    "publish": {
      "dependsOn": ["^build", "test"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "persistent": true
    },
    "db:start": {
      "cache": false,
      "persistent": true
    },
    "db:stop": {
      "cache": false,
      "persistent": true
    },
    "db:watch": {
      "cache": false,
      "persistent": true
    },
    "db:down": {
      "cache": false,
      "persistent": true
    }
  }
}
